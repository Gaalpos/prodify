{
  "name": "prodify-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 execute prodify-cloud --local --file schema.sql",
    "db:remote": "wrangler d1 execute prodify-cloud --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
